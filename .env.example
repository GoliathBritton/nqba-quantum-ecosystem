# FLYFOX AI Platform Configuration
PORT=3000
NODE_ENV=development

# Security
# 32-byte key, base64 encoded (recommended)
# FLYFOX_MASTER_KEY=
JWT_SECRET=change-me-in-production

# Quantum Ecosystem
QHC_ENABLED=true
QDH_ENABLED=true
DYNEX_ENABLED=true
SIGMAEQ_VERSION=4

# Optional billing (Stripe)
